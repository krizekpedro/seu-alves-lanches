# Copie para .env e preencha. NUNCA suba o .env para o GitHub.
DATABASE_URL=postgresql://seualves:seualves@localhost:5432/seualves
REDIS_URL=redis://localhost:6379
JWT_SECRET=troque-por-um-segredo-longo
API_PORT=3000

# iFood (preencher depois da criação do app no Portal do Desenvolvedor)
IFOOD_CLIENT_ID=
IFOOD_CLIENT_SECRET=
IFOOD_MERCHANT_ID=
IFOOD_API_BASE=https://merchant-api.ifood.com.br
# O iFood Entrega (Shipping) usa as mesmas credenciais acima; ative o módulo Shipping no app do portal.

# 99 Entrega (preencher com a conta de desenvolvedor da 99; caminhos conforme a documentação recebida)
N99_CLIENT_ID=
N99_CLIENT_SECRET=
N99_API_BASE=
# Opcionais: só se a documentação da 99 usar caminhos diferentes do padrão do adaptador
# N99_PATH_TOKEN=/oauth/token
# N99_PATH_QUOTE=/deliveries/estimate
# N99_PATH_CREATE=/deliveries
# N99_PATH_GET=/deliveries/{id}
# N99_PATH_CANCEL=/deliveries/{id}/cancel
# Segredo da URL de aviso automático cadastrada na 99: https://SEU-DOMINIO/webhooks/n99?token=ESTE_VALOR
N99_WEBHOOK_TOKEN=

# Conta do dono criada pelo seed
OWNER_EMAIL=dono@seualves.com.br
OWNER_PASSWORD=troque-esta-senha
