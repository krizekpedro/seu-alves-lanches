{
  "name": "seu-alves",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @seu-alves/db generate",
    "db:migrate": "pnpm --filter @seu-alves/db migrate",
    "db:seed": "pnpm --filter @seu-alves/db seed"
  },
  "devDependencies": {
    "turbo": "2.11.13",
    "typescript": "5.9.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["@prisma/client", "@prisma/engines", "prisma", "esbuild", "@nestjs/core", "@tailwindcss/oxide", "msgpackr-extract"]
  }
}
